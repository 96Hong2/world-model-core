{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldmodel.example/contracts/ontology.schema.json",
  "title": "Business World Model Ontology — 15 labels / 18 relations",
  "description": "REVISED-MASTER-PLAN v2.1 §3 정본. v1.0 §D-1(14라벨)+BusinessDomain=15라벨, v1.0 §D-2(16관계)+IN_DOMAIN+TARGETS=18관계. 그래프 쓰기 payload({nodes,edges})를 검증한다. 라벨·관계 type은 closed set이며 LLM이 신규 type을 제안해도 그래프에 쓰지 않는다.",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/Node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/Edge" } }
  },

  "x-label-count": 15,
  "x-relation-count": 18,
  "x-labels": {
    "business": [
      "Product",
      "Feature",
      "Capability",
      "Account",
      "Industry",
      "Need",
      "Deal",
      "Competitor",
      "Test",
      "BusinessDomain"
    ],
    "knowledge": ["Source", "Evidence", "Event", "Observation", "Claim"]
  },
  "x-reserved-not-persisted": {
    "Insight": "v1.0 §D-1: 라벨만 예약, 기본 비영속. 사용자가 저장을 승인할 때만 노드화하며 1A에서는 생성하지 않는다. 15라벨 집계에 포함하지 않는다."
  },
  "x-relations": {
    "knowledge_backbone": [
      "FROM_SOURCE",
      "DERIVED_FROM",
      "OBSERVED_IN",
      "MENTIONS",
      "SUPPORTS",
      "CONTRADICTS",
      "ABOUT",
      "SUPERSEDES"
    ],
    "business": [
      "BELONGS_TO",
      "HAS_NEED",
      "WITH_ACCOUNT",
      "FOR_PRODUCT",
      "BLOCKED_BY",
      "ADDRESSED_BY",
      "IMPLEMENTS",
      "VALIDATED_BY",
      "IN_DOMAIN",
      "TARGETS"
    ]
  },
  "x-not-adopted": {
    "Account-REQUESTED->Feature": "v1.0 §D-2. 영업 자료는 Feature 굵기로 요구를 말하지 않아 오매핑을 양산한다. Account-HAS_NEED->Need-ADDRESSED_BY->Capability 경로로 대체한다.",
    "Capability-*->BusinessDomain": "REVISED §3. Need 경유로 도출 가능하므로 직접 관계를 만들지 않는다(과대설계 방지).",
    "Feature-PART_OF->Product / Competitor-OFFERS->Capability / Event-INVOLVES->Account": "v1.0 §D-2에 '보조'로 언급됐으나 REVISED §3이 확정한 18관계 closed set에는 포함되지 않는다. 1A에서 만들지 않는다. → contracts/README 없음, A0 미확정 항목으로 응답에 보고함."
  },
  "x-open-questions": [
    "Event가 Account에 직접 붙는 관계가 closed set 18개에 없다. 1A에서 영업활동 Event↔Account 연결은 (Observation)-[:OBSERVED_IN]->(Event) + (Observation)-[:MENTIONS]->(Account) 2홉으로만 표현된다. Slack #all-영업활동공유 599건이 이 경로를 탄다. 사람 확인 필요.",
    "Person 라벨이 없다. Slack 참석자·영업대표·고객사 담당자는 Entity로 만들지 않고 Evidence 원문(마스킹 후)에만 남는다. slack-inventory §3.3의 Person-WORKS_FOR->Account 제안은 1A 범위 밖이다."
  ],

  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$" },
    "nullableIsoDate": {
      "anyOf": [{ "$ref": "#/$defs/isoDate" }, { "type": "null" }]
    },

    "provenance": {
      "type": "object",
      "description": "모든 노드 공통. source_ids는 ACL 판정 입력이자 traceability 근거(v1.0 §D-4).",
      "required": ["source_ids"],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "temporal": {
      "type": "object",
      "description": "REVISED §0: Snapshot MVP지만 valid_from·superseded 필드는 유지한다(V2 데이터 이관 방지).",
      "properties": {
        "valid_from": { "$ref": "#/$defs/nullableIsoDate" },
        "valid_until": { "$ref": "#/$defs/nullableIsoDate" },
        "observed_at": { "$ref": "#/$defs/nullableIsoDate" },
        "superseded_by": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "superseded_at": { "$ref": "#/$defs/nullableIsoDate" }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "created_at": { "$ref": "#/$defs/isoDate" },
        "updated_at": { "$ref": "#/$defs/isoDate" },
        "pipeline_run_id": { "type": "string" }
      }
    },
    "nodeBase": {
      "type": "object",
      "required": ["label", "id", "natural_key"],
      "properties": {
        "label": { "type": "string" },
        "id": { "type": "string", "minLength": 1 },
        "natural_key": {
          "type": "string",
          "minLength": 1,
          "description": "MERGE 키 원본 문자열. idempotent 재실행의 근거."
        },
        "active": { "type": "boolean", "default": true }
      },
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        { "$ref": "#/$defs/temporal" },
        { "$ref": "#/$defs/audit" }
      ]
    },

    "Node": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }],
      "oneOf": [
        { "$ref": "#/$defs/Product" },
        { "$ref": "#/$defs/Feature" },
        { "$ref": "#/$defs/Capability" },
        { "$ref": "#/$defs/Account" },
        { "$ref": "#/$defs/Industry" },
        { "$ref": "#/$defs/Need" },
        { "$ref": "#/$defs/Deal" },
        { "$ref": "#/$defs/Competitor" },
        { "$ref": "#/$defs/Test" },
        { "$ref": "#/$defs/BusinessDomain" },
        { "$ref": "#/$defs/Source" },
        { "$ref": "#/$defs/Evidence" },
        { "$ref": "#/$defs/Event" },
        { "$ref": "#/$defs/Observation" },
        { "$ref": "#/$defs/Claim" }
      ],
      "unevaluatedProperties": false
    },

    "Product": {
      "type": "object",
      "x-natural-key": "normalize(name)",
      "x-evidence": "활동일지·Slack 채널에 현행 제품명(오로라웍스)·레거시 제품명(오로라원)·부속 제품명이 병존한다. 같은 제품이 문서마다 다른 표기로 나온다.",
      "required": ["label", "name"],
      "properties": {
        "label": { "const": "Product" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "generation": {
          "enum": ["legacy", "current", "new_feature"],
          "description": "오로라원=legacy, 오로라웍스=current, 오로라웍스 메일=new_feature(레퍼런스 없음 명시)"
        },
        "product_line": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "Feature": {
      "type": "object",
      "x-natural-key": "normalize(screen + '|' + area + '|' + sub_area + '|' + name)",
      "x-evidence": "기능맵 v2.1 시트 헤더 r3, 데이터 r4~r519. 데이터행 470 / 고유 기능명 393.",
      "required": ["label", "name", "screen"],
      "properties": {
        "label": { "const": "Feature" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "screen": {
          "type": "string",
          "description": "기능맵 B열(화면). 실측 16종 중 데이터행이 붙는 것은 15종(add on Feature는 구분선 행)."
        },
        "area": {
          "type": "string",
          "description": "기능맵 C열(영역). 37 고유값이나 화면마다 재등장하므로 (screen, area) 쌍이 실제 키."
        },
        "sub_area": {
          "type": "string",
          "description": "기능맵 D열(상세분류). 106 고유값."
        },
        "livetalk_supported": {
          "type": "boolean",
          "description": "기능맵 G열. 원문은 'V'(242) 와 '√' U+221A(113) 2벌 → 파서에서 true로 정규화."
        },
        "grouptalk_supported": {
          "type": "boolean",
          "description": "기능맵 H열. 'V'(252) + '√'(12)."
        },
        "introduced_in": {
          "enum": ["1.0.0", "1.1.0", "2.0.0", "2.1.0", "unknown"],
          "description": "I~L 컬럼에서 왼쪽부터 처음 'O'가 나오는 컬럼. v2.0/v1.0 시트 집합 비교로 구하면 안 된다(교차검증 57~69%만 일치, 기능명 리네이밍 때문)."
        },
        "available_versions": {
          "type": "array",
          "items": { "enum": ["1.0.0", "1.1.0", "2.0.0", "2.1.0"] }
        },
        "note": {
          "type": "string",
          "description": "기능맵 M열(비고). 실측 2건."
        },
        "merged_description_rows": {
          "type": "integer",
          "description": "기능명 없이 설명만 있는 행 16개는 직전 Feature에 병합한다. 병합한 행 수."
        }
      }
    },

    "Capability": {
      "type": "object",
      "x-natural-key": "capability_id (config/capability-taxonomy.yaml 의 id)",
      "x-rule": "canonical 항목은 taxonomy 파일에만 존재한다. LLM은 기존 항목으로의 매핑 후보 제안까지만 하고 신규 canonical 생성 금지(REVISED §3).",
      "required": ["label", "capability_id", "name"],
      "properties": {
        "label": { "const": "Capability" },
        "capability_id": { "type": "string", "pattern": "^cap\\.[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "definition": { "type": "string" },
        "addon": {
          "type": "boolean",
          "description": "기능맵 'add on Feature' / 매뉴얼 Add on Feature 6종(상담센터) vs 1종(협업센터)."
        },
        "license_gated": {
          "type": "boolean",
          "description": "예: 외국어 대화 지원(portal adoc), 품질평가(매뉴얼: 라이선스 + 권한 2중 게이트)."
        },
        "unmapped_raw": {
          "type": "string",
          "description": "taxonomy 매핑 실패 시 원문 표현을 기록만 한다(신규 canonical 생성 금지)."
        }
      }
    },

    "Account": {
      "type": "object",
      "x-natural-key": "canonical_name (config/aliases.yaml 의 accounts.canonical)",
      "x-evidence": "활동일지 3계층 + 주간계획 2표 + pain 3시트에서 원문 표기 129종, 병합 후 약 120. Slack 리드등록알림에서 118종 추가.",
      "x-rule": "부분 문자열·유사도 자동 병합 금지(v1.0 §D-5). 마바손해보험≠마바캐피탈.",
      "required": ["label", "canonical_name"],
      "properties": {
        "label": { "const": "Account" },
        "canonical_name": { "type": "string", "minLength": 1 },
        "raw_names": {
          "type": "array",
          "items": { "type": "string" },
          "description": "실제로 관측된 원문 표기 전부."
        },
        "account_kind": {
          "enum": [
            "customer",
            "prospect",
            "lead",
            "partner",
            "self",
            "unknown"
          ],
          "description": "self=자사(오로라소프트). 리드 테스트 데이터로 자사가 등록된 건이 실재할 수 있으므로 배제 대상."
        },
        "sfdc_note": {
          "type": "string",
          "description": "'(기회 미생성)' 같은 괄호 주석은 이름이 아니라 SFDC 상태."
        }
      }
    },

    "Industry": {
      "type": "object",
      "x-natural-key": "normalize(name)",
      "x-evidence": "활동일지 사람별 시트 D열(업권) 11종: 보험사38·은행사19·캐피탈사14·기타14·카드사9·증권사8·유통사6·공공4·서비스사3·제조사2·법인영업1.",
      "required": ["label", "name"],
      "properties": {
        "label": { "const": "Industry" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    },

    "Need": {
      "type": "object",
      "x-natural-key": "need_id (config/need-taxonomy.yaml 의 id). unmapped 는 sha256(evidence_id + normalized_statement).",
      "x-rule": "Raw 표현은 Evidence/Observation에 원문 그대로 보존하고 canonical Need 노드에 연결한다(원문 유실 없음).",
      "required": ["label", "need_type"],
      "properties": {
        "label": { "const": "Need" },
        "need_id": {
          "anyOf": [
            { "type": "string", "pattern": "^need\\.[a-z0-9_]+$" },
            { "type": "null" }
          ]
        },
        "name": { "type": "string" },
        "definition": { "type": "string" },
        "need_type": {
          "enum": ["pain", "request", "objection"],
          "description": "v1.0 §D-1: 실물에서 4라벨 경계가 흐려 3값으로 통합."
        },
        "canonical": {
          "type": "boolean",
          "description": "false면 taxonomy 매핑 실패(unmapped). 기록만 하고 taxonomy 갱신은 사람이 한다."
        },
        "unmapped_raw": { "type": "string" }
      }
    },

    "Deal": {
      "type": "object",
      "x-natural-key": "normalize(account_canonical + '|' + deal_scope)",
      "x-evidence": "활동일지 일일보고 5.영업 진행 현황(딜 사실의 정본) + 사람별 시트 G열(단계).",
      "x-rule": "'다라카드 자동차'·'다라카드 채권' 같은 표기는 Account 3개가 아니라 Account 1개 + Deal 2개다(deal_scope 로 분해).",
      "required": ["label", "account_canonical"],
      "properties": {
        "label": { "const": "Deal" },
        "account_canonical": { "type": "string" },
        "deal_scope": {
          "type": "string",
          "description": "같은 고객사의 부서·업무 단위 구분(예: 자동차, 채권)."
        },
        "stage_system": {
          "enum": [
            "activity_person_sheet",
            "daily_report_section5",
            "weekly_plan_section6",
            "slack"
          ],
          "description": "단계 어휘가 시트마다 다르므로 어느 체계의 값인지 반드시 기록한다."
        },
        "stage_value": {
          "type": "string",
          "description": "원문 그대로. 사람별 시트 9종(운영고객56·타켓고객21[오타 원문]·방문고객14·잠재고객7·제안고객6·접촉고객6·관심고객5·협상고객1·수주고객1) / 일일보고 4종(제안20·협상12·검수2·실패1) / 주간계획 8종(리드발굴47·사업기회 발굴25·사업기회발굴16·사업예산확보15·기회발굴13 등)."
        },
        "outcome": { "enum": ["won", "lost", "open", "unknown"] },
        "amount_raw": {
          "type": "string",
          "description": "원문 문자열 필수 보존. 실측 11종: '-','0.5','0.6억','0.8','1.9억','2.7억','2억','3.77억','4억','4억 -> 3.44억','5억'. 단위 미통일 + 변경이력이 한 셀."
        },
        "amount_krw": {
          "anyOf": [{ "type": "number" }, { "type": "null" }],
          "description": "정규화 추정치. amount_raw 없이 단독 인용 금지."
        },
        "success_probability": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ],
          "description": "일일보고 I열. 실측 0.25~0.95."
        },
        "current_issue": { "type": "string" },
        "next_action": { "type": "string" },
        "support_needed": {
          "type": "string",
          "description": "실측 rare-critical 신호: 6월15일 r36 '경영진 의사결정 지원'."
        }
      }
    },

    "Competitor": {
      "type": "object",
      "x-natural-key": "normalize(name)",
      "x-evidence": "[자차캐피탈] 도입추진(안)의 경쟁 비교표(협업툴 A·B·C·D). 코퍼스에 경쟁사 비교표가 단 하나뿐인 경우가 흔하다.",
      "required": ["label", "name", "competitor_kind"],
      "properties": {
        "label": { "const": "Competitor" },
        "name": { "type": "string", "minLength": 1 },
        "competitor_kind": {
          "enum": ["vendor", "in_house", "partner"],
          "description": "partner=파트너 겸 경쟁. in_house=고객 자체 구축."
        }
      }
    },

    "Test": {
      "type": "object",
      "x-natural-key": "repo_relative_path + '::' + test_name",
      "x-status": "1A에서는 A2-f 코드/테스트 시드로 소수만 생성. Phase 3 Quality Intelligence의 기반 한 줄.",
      "required": ["label", "name"],
      "properties": {
        "label": { "const": "Test" },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "kind": { "enum": ["unit", "integration", "e2e", "unknown"] }
      }
    },

    "BusinessDomain": {
      "type": "object",
      "x-natural-key": "bd_id (config/bd-seed.yaml 의 id)",
      "x-evidence": "BD Overview.xlsx 7시트 전량 직접 확인(BM 정의 r2~r19 / 시장사이즈 r2~r17+각주 r20 / 진척도 r2~r17+범례 r20~21 / 기대효과 가로 3블록 r2~r12 / 전략매출 B2~B3 / Guest통제 B2~B3 / 멀티BM B2~C11).",
      "x-rule": "BD별 Entity Type을 만들지 않고 노드 데이터로 넣는다(REVISED §3).",
      "required": ["label", "bd_id", "name", "industry_scope"],
      "properties": {
        "label": { "const": "BusinessDomain" },
        "bd_id": { "type": "string", "pattern": "^bd\\.[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "신·구 명칭 2벌 문제 대응. 시장사이즈 각주 r20 '** 새롭게 정의된 BM 기준으로는 시장 사이즈가 모호할 수 있기에 당분간 유지'가 근거 원문."
        },
        "industry_scope": {
          "enum": ["금융", "비금융", "공통"],
          "description": "BM 정의 시트 B열. B3:B14=금융, B15:B18=비금융, B19=공통."
        },
        "target_company": { "type": "string", "description": "BM 정의 D열." },
        "br_role": {
          "type": "string",
          "description": "BM 정의 E열(Business Representative, 내부 담당자). 퇴직연금·신용평가는 다중행."
        },
        "guest_role": {
          "type": "string",
          "description": "BM 정의 G열(외부 게스트)."
        },
        "work_desc": { "type": "string", "description": "BM 정의 H열." },
        "market_size_note": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "description": "시장사이즈 D열. '80억 ~ 100억\\n(4억 기준)' 형태 문자열이며 숫자가 아니다. 원문 보존 필수."
        },
        "target_company_detail": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "description": "시장사이즈 E열. 실제 회사 약칭 나열(삼성·메리츠·DB…). 약칭이라 Account 매칭에 그대로 쓰면 위험."
        },
        "maturity": {
          "type": "object",
          "description": "진척도 시트 C~G열. 값은 '✔'/'제외'/공백. 범례 r20·r21이 같은 '✔' 기호에 '완료'와 '보완필요' 두 라벨을 달아 두어 값만으로는 구분 불가(색상 구분 추정, data_only=True로는 미확인).",
          "properties": {
            "제안가치_준비": { "$ref": "#/$defs/maturityValue" },
            "세일즈킷_완성": { "$ref": "#/$defs/maturityValue" },
            "이관_여부": { "$ref": "#/$defs/maturityValue" },
            "시장배분_여부": { "$ref": "#/$defs/maturityValue" },
            "제품지원_여부": { "$ref": "#/$defs/maturityValue" }
          }
        },
        "channel_type": {
          "anyOf": [{ "enum": ["상시", "온디맨드"] }, { "type": "null" }],
          "description": "전략매출 시트 B2·B3. 두 줄에 나열된 BD만 값이 있고 나머지는 null."
        },
        "guest_control": {
          "anyOf": [{ "enum": ["가능", "불가"] }, { "type": "null" }],
          "description": "Guest통제 시트 B2·B3."
        },
        "bd_status": {
          "anyOf": [{ "enum": ["관리", "후보", "제외"] }, { "type": "null" }],
          "description": "기대효과 시트가 정본(관리 BM 9 / 후보 BM 4 / 제외 BM 2). 가로 3블록(B·I·P열) 구조라 단순 행 순회로는 못 읽는다."
        },
        "expected_effects": {
          "type": "array",
          "items": {
            "enum": [
              "매출 증대(세일즈)",
              "비용 절감(업무생산성)",
              "컴플라이언스 준수",
              "연결율 향상",
              "소통 통합, 자산화"
            ]
          },
          "description": "기대효과 시트 지표 헤더 r3. 범례 r16·r17이 같은 '✔'에 '직접효과'/'간접효과' 두 라벨 → 구분 미확인."
        },
        "partners": {
          "type": "array",
          "items": { "type": "string" },
          "description": "진척도 시트의 파트너사 열에서 채운다."
        },
        "needs_human_confirm": { "type": "boolean" },
        "confirm_reason": { "type": "string" }
      }
    },
    "maturityValue": {
      "anyOf": [{ "enum": ["✔", "제외"] }, { "type": "null" }]
    },

    "Source": {
      "type": "object",
      "x-natural-key": "sha256(canonical_location)",
      "required": [
        "label",
        "source_id",
        "source_type",
        "canonical_location",
        "sensitivity",
        "visibility"
      ],
      "properties": {
        "label": { "const": "Source" },
        "source_id": { "type": "string" },
        "source_type": { "$ref": "source_type.enum.json" },
        "format": {
          "type": "string",
          "description": "xlsx|pdf|pptx|docx|html|md|jsonl|adoc|ts 등. source_type과 분리(v1.0 §D-6)."
        },
        "canonical_location": { "type": "string" },
        "content_hash": { "type": "string" },
        "modified_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_ingested_at": { "$ref": "#/$defs/nullableIsoDate" },
        "origin": {
          "type": "string",
          "description": "작성 주체. 예: 기능맵 문서정보 시트의 작성자(주대희)·검토자(전략사업본부)."
        },
        "author_role": { "type": "string" },
        "doc_status": {
          "enum": ["approved", "draft", "superseded", "unknown"]
        },
        "visibility": { "enum": ["internal", "restricted"] },
        "sensitivity": {
          "enum": ["internal", "restricted"],
          "description": "1A는 단일 sensitivity 필터(REVISED §0). deny-by-default."
        },
        "pii_flag": { "type": "boolean" },
        "extractor": {
          "enum": ["deterministic", "vision"],
          "description": "vision=이미지 PDF 판독본. 원본 파싱이 물리적으로 불가능한 2건의 명시적 예외."
        },
        "source_status": {
          "enum": ["active", "drifted", "missing", "excluded"]
        },
        "source_of_record_for": {
          "type": "string",
          "description": "§4 ⑥ VERIFIED 판정 근거. 이 소스가 무엇의 정본인가."
        },
        "authority_rank": {
          "not": {},
          "description": "저장 금지. authority는 (source, 질문맥락) 쌍의 속성이므로 정책 파일이 질의 시 계산한다(v1.0 §D-4·§F-1)."
        }
      }
    },

    "Evidence": {
      "type": "object",
      "x-natural-key": "sha256(source_id + locator + snippet_hash)",
      "x-rule": "불변, 상태 없음(v1.0 §E-1). 내용이 바뀌면 새 Evidence를 만들고 구 Evidence는 보존한다.",
      "required": ["label", "evidence_id", "source_id", "locator", "snippet"],
      "properties": {
        "label": { "const": "Evidence" },
        "evidence_id": { "type": "string" },
        "source_id": { "type": "string" },
        "locator": {
          "type": "string",
          "description": "형식별 실측 마커: pdf '=== [PAGE n] ===' / vision '===== PAGE n =====' / pptx '=== [SLIDE n] ===' / docx '[Heading n]'+'=== [TABLE n] ===' / xlsx '시트!셀' / adoc '경로#앵커또는헤딩원문' / md '파일#h2' / slack 'channel/ts'. HTML 4종은 마커 0이라 자체 번호 라벨(Q1~Q6, 01~04, N단계)을 쓴다."
        },
        "snippet": {
          "type": "string",
          "maxLength": 500,
          "description": "발췌 500자 상한. 마스킹 후 값만 저장한다(마스킹 전 데이터 저장 금지)."
        },
        "snippet_hash": { "type": "string" },
        "authored_at": { "$ref": "#/$defs/nullableIsoDate" },
        "masked": { "type": "boolean" },
        "transcription_flags": {
          "type": "array",
          "items": { "enum": ["판독불가", "판독주의"] },
          "description": "vision 판독본에 실재하는 표기. 이 구간은 숫자·고유명사 추출 대상에서 제외."
        }
      }
    },

    "Event": {
      "type": "object",
      "x-natural-key": "sha256(source_id + locator + normalized_title)",
      "required": ["label", "event_type"],
      "properties": {
        "label": { "const": "Event" },
        "event_type": {
          "enum": [
            "meeting",
            "contact",
            "release",
            "incident",
            "deal_status_change"
          ]
        },
        "title": { "type": "string" },
        "mode": {
          "type": "string",
          "description": "Slack #all-영업활동공유 '• 일시 : … / cc' 의 뒷조각. 실측 값: cc·미팅·유선·대면·장소명."
        },
        "next_actions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "[Action Item] 섹션 불릿. Claim이 아니다."
        }
      }
    },

    "Observation": {
      "type": "object",
      "x-natural-key": "sha256(evidence_id + normalized_statement)",
      "x-rule": "Source의 직접 기록은 Observation으로 확정한다(§4 ⑥ 1단). Observation은 반박 대상이 아니며 상태를 갖지 않는다.",
      "required": ["label", "observation_id", "statement", "evidence_ids"],
      "properties": {
        "label": { "const": "Observation" },
        "observation_id": { "type": "string" },
        "statement": {
          "type": "string",
          "description": "'이 자료에 이렇게 적혀 있다' 형태. 예: 'BD Overview 기대효과 시트가 B2B유통 계열(제조·식자재유통)을 관리 BM으로 분류했다.'"
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "extractor": {
          "type": "string",
          "description": "deterministic 이거나 model@version + prompt_hash."
        },
        "criticality": {
          "type": "array",
          "items": { "type": "string" },
          "description": "config/criticality-rules.yaml 의 rule id 목록."
        }
      }
    },

    "Claim": {
      "type": "object",
      "x-natural-key": "ULID 신규 + dedup 후보 검사(subject-key)",
      "x-rule": "LLM 추출물은 항상 CANDIDATE. 어떤 LLM도 status를 직접 쓰지 못한다(v1.0 I4).",
      "required": ["label", "claim_id", "statement", "status", "claim_kind"],
      "properties": {
        "label": { "const": "Claim" },
        "claim_id": { "type": "string" },
        "statement": { "type": "string" },
        "status": { "$ref": "state.enum.json#/$defs/status" },
        "lane": {
          "type": "array",
          "items": { "$ref": "state.enum.json#/$defs/lane" }
        },
        "claim_kind": { "$ref": "state.enum.json#/$defs/claim_kind" },
        "claim_domain": { "$ref": "policy.schema.json#/$defs/claimDomain" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "observation_ids": { "type": "array", "items": { "type": "string" } },
        "contradicted_by": { "type": "array", "items": { "type": "string" } },
        "independent_source_count": { "type": "integer", "minimum": 0 },
        "stale_flag": { "type": "boolean" },
        "last_verified_at": { "$ref": "#/$defs/nullableIsoDate" },
        "confidence": {
          "not": {},
          "description": "금지. 확률처럼 읽히는 숫자를 노출하지 않는다. Evidence Strength 밴드로 대체(REVISED §0·§4)."
        }
      }
    },

    "Edge": {
      "type": "object",
      "required": ["type", "from", "to"],
      "properties": {
        "type": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "from_label": { "type": "string" },
        "to_label": { "type": "string" },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "status": { "$ref": "state.enum.json#/$defs/status" },
        "valid_from": { "$ref": "#/$defs/nullableIsoDate" },
        "valid_until": { "$ref": "#/$defs/nullableIsoDate" },
        "first_observed_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_observed_at": { "$ref": "#/$defs/nullableIsoDate" },
        "independent_source_count": { "type": "integer", "minimum": 0 },
        "resolution_status": {
          "enum": ["claimed", "verified"],
          "description": "ADDRESSED_BY 전용(v1.0 §D-2)."
        }
      },
      "oneOf": [
        { "$ref": "#/$defs/edgeKnowledge" },
        { "$ref": "#/$defs/edgeBusiness" }
      ],
      "unevaluatedProperties": false
    },

    "edgeKnowledge": {
      "type": "object",
      "description": "지식 백본 8종. claim_ids 불필요.",
      "properties": {
        "type": {
          "enum": [
            "FROM_SOURCE",
            "DERIVED_FROM",
            "OBSERVED_IN",
            "MENTIONS",
            "SUPPORTS",
            "CONTRADICTS",
            "ABOUT",
            "SUPERSEDES"
          ]
        }
      },
      "required": ["type"],
      "x-endpoints": {
        "FROM_SOURCE": ["Evidence", "Source"],
        "DERIVED_FROM": ["Observation", "Evidence"],
        "OBSERVED_IN": ["Observation", "Event"],
        "MENTIONS": [
          "Observation",
          "Product|Feature|Capability|Account|Industry|Need|Deal|Competitor|Test|BusinessDomain"
        ],
        "SUPPORTS": ["Evidence", "Claim"],
        "CONTRADICTS": ["Evidence", "Claim"],
        "ABOUT": [
          "Claim",
          "Product|Feature|Capability|Account|Industry|Need|Deal|Competitor|Test|BusinessDomain"
        ],
        "SUPERSEDES": ["Claim", "Claim"]
      }
    },

    "edgeBusiness": {
      "type": "object",
      "description": "비즈니스 10종. 승격된 지식의 질의용 투영이며 claim_ids 최소 1개가 필수다. 근거 없는 엣지는 생성 자체가 불가능하다(v1.0 §D-4).",
      "required": ["type", "claim_ids"],
      "properties": {
        "type": {
          "enum": [
            "BELONGS_TO",
            "HAS_NEED",
            "WITH_ACCOUNT",
            "FOR_PRODUCT",
            "BLOCKED_BY",
            "ADDRESSED_BY",
            "IMPLEMENTS",
            "VALIDATED_BY",
            "IN_DOMAIN",
            "TARGETS"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "x-endpoints": {
        "BELONGS_TO": ["Account", "Industry"],
        "HAS_NEED": ["Account", "Need"],
        "WITH_ACCOUNT": ["Deal", "Account"],
        "FOR_PRODUCT": ["Deal", "Product"],
        "BLOCKED_BY": ["Deal", "Need"],
        "ADDRESSED_BY": ["Need", "Capability"],
        "IMPLEMENTS": ["Feature", "Capability"],
        "VALIDATED_BY": ["Feature", "Test"],
        "IN_DOMAIN": ["Deal|Need|Event", "BusinessDomain"],
        "TARGETS": ["BusinessDomain", "Industry"]
      },
      "x-evidence": {
        "IN_DOMAIN": "활동일지의 업무 도메인 열이 deterministic 입력. 단 그 어휘 중 BD와 직접 대응되는 것은 일부뿐이고 나머지는 제품 축 또는 복합값이다.",
        "TARGETS": "BD 레지스트리의 산업 열 + 멀티BD 시트(업권별로 적용 가능한 BD 목록을 매핑한다)."
      }
    }
  }
}
